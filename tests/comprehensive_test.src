// Comprehensive test demonstrating various type checker features

// Test 1: Arithmetic operations with type promotion
function float testArithmetic() {
    int a = 10;
    int b = 3;
    float c = 5.5;
    
    int intResult = a + b;
    float mixedResult = a + c;
    float divResult = a / b;
    
    return mixedResult;
}

// Test 2: Comparison and logical operations
function bool testComparisons(int x, int y) {
    bool greater = x > y;
    bool equal = x == y;
    bool lesserOrEqual = x <= y;
    
    bool combined = greater && equal;
    bool orCombined = greater || equal;
    bool negated = !equal;
    
    return combined;
}

// Test 3: Ternary operator
function int testTernary(int a, int b) {
    int max = a > b ? a : b;
    return max;
}

// Test 4: Nested control flow
function int testNestedFlow(int n) {
    int result = 0;
    int i = 0;
    
    while (i < n) {
        if (i % 2 == 0) {
            result = result + i;
        } else {
            result = result - i;
        }
        i = i + 1;
    }
    
    return result;
}

// Test 5: For loop
function int testForLoop(int limit) {
    int sum = 0;
    int i = 0;
    
    for (i = 0; i < limit; i = i + 1) {
        sum = sum + i;
    }
    
    return sum;
}

// Test 6: Do-while loop
function int testDoWhile(int n) {
    int count = 0;
    
    do {
        count = count + 1;
    } while (count < n);
    
    return count;
}

// Test 7: Switch statement
function int testSwitch(int x) {
    int result = 0;
    
    switch (x) {
        case 1:
            result = 10;
            break;
        case 2:
            result = 20;
            break;
        case 3:
            result = 30;
            break;
        default:
            result = 0;
    }
    
    return result;
}

// Test 8: Unary operations
function int testUnary(int x) {
    int negated = -x;
    int positive = +x;
    bool notX = !x;
    
    return negated;
}

// Test 9: Bitwise operations
function int testBitwise(int a, int b) {
    int andResult = a & b;
    int orResult = a | b;
    int xorResult = a ^ b;
    int notResult = ~a;
    int leftShift = a << 2;
    int rightShift = b >> 1;
    
    return andResult;
}

// Test 10: Multiple return paths
function int testMultiReturn(int x) {
    if (x > 0) {
        return 1;
    } else if (x < 0) {
        return -1;
    } else {
        return 0;
    }
}

// Test 11: Void function (no return needed)
function void testVoidFunc() {
    int x = 42;
    print x;
}

// Test 12: Complex expression
function float testComplexExpr(int a, int b, float c) {
    float result = (a + b) * c / 2.0;
    return result;
}

// Test 13: Chained comparisons in conditions
function bool testChainedComparison(int x, int y, int z) {
    if (x < y && y < z) {
        return true;
    }
    return false;
}

// Main function demonstrating all tests
function void main() {
    float arithResult = testArithmetic();
    bool compResult = testComparisons(10, 20);
    int ternResult = testTernary(15, 25);
    int nestedResult = testNestedFlow(10);
    int forResult = testForLoop(10);
    int doWhileResult = testDoWhile(5);
    int switchResult = testSwitch(2);
    int unaryResult = testUnary(42);
    int bitwiseResult = testBitwise(12, 7);
    int multiRetResult = testMultiReturn(5);
    
    testVoidFunc();
    
    float complexResult = testComplexExpr(10, 20, 3.14);
    bool chainResult = testChainedComparison(1, 2, 3);
    
    print arithResult;
    print compResult;
    print ternResult;
    print nestedResult;
    print forResult;
    print doWhileResult;
    print switchResult;
    print unaryResult;
    print bitwiseResult;
    print multiRetResult;
    print complexResult;
    print chainResult;
}
