// Test program for IR generation
// This file demonstrates various language features

int globalVar = 100;
int result = 0;

function int add(int a, int b) {
    return a + b;
}

function int factorial(int n) {
    if (n <= 1) {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

function int fibonacci(int n) {
    if (n <= 1) {
        return n;
    } else {
        return fibonacci(n - 1) + fibonacci(n - 2);
    }
}

function void testArithmetic() {
    int x = 10;
    int y = 5;
    int sum = x + y;
    int diff = x - y;
    int prod = x * y;
    int quot = x / y;
    int rem = x % y;
    
    print sum;
    print diff;
    print prod;
}

function void testComparison() {
    int a = 10;
    int b = 20;
    
    if (a < b) {
        print a;
    } else {
        print b;
    }
    
    if (a == 10) {
        print 1;
    } else {}
    
    if (a != b) {
        print 1;
    } else {}
}

function void testLoops() {
    // While loop
    int i = 0;
    while (i < 5) {
        print i;
        i = i + 1;
    }
    
    // For loop
    for (int j = 0; j < 3; j = j + 1;) {
        print j;
    }
    
    // Do-while loop
    int k = 0;
    do {
        print k;
        k = k + 1;
    } while (k < 3);
}

function void testBreakContinue() {
    int i = 0;
    while (i < 10) {
        if (i == 5) {
            break;
        } else {}
        
        if (i == 2) {
            i = i + 1;
            continue;
        } else {}
        
        print i;
        i = i + 1;
    }
}

function void testSwitch(int x) {
    switch (x) {
        case 1:
            print 10;
            break;
        case 2:
            print 20;
            break;
        case 3:
            print 30;
            break;
        default:
            print 0;
    }
}

function int testTernary(int a, int b) {
    int max = a > b ? a : b;
    return max;
}

function void testLogical() {
    int a = 1;
    int b = 0;
    
    if (a && b) {
        print 1;
    } else {
        print 0;
    }
    
    if (a || b) {
        print 1;
    } else {
        print 0;
    }
}

function void testBitwise() {
    int x = 12;
    int y = 5;
    
    int andResult = x & y;
    int orResult = x | y;
    int xorResult = x ^ y;
    int notResult = ~x;
    int leftShift = x << 2;
    int rightShift = x >> 2;
    
    print andResult;
}

function void testNested() {
    int i = 0;
    while (i < 3) {
        int j = 0;
        while (j < 3) {
            if (i == j) {
                print i;
            } else {}
            j = j + 1;
        }
        i = i + 1;
    }
}

function int main() {
    testArithmetic();
    testComparison();
    testLoops();
    testBreakContinue();
    testSwitch(2);
    
    int maxVal = testTernary(10, 20);
    print maxVal;
    
    testLogical();
    testBitwise();
    testNested();
    
    int fact5 = factorial(5);
    print fact5;
    
    int fib7 = fibonacci(7);
    print fib7;
    
    return 0;
}
