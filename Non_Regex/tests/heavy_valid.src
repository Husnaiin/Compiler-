include "mylib";

fn int complex_fn(int x, float y, string s, bool b, char c) {
	// Declarations and literals
	int a = 0;
	float fnum = 12.34;
	string emp = "";
	string str = "line1\n\t\"quote\"\\backslash\'single'";
	char ch1 = '\n';
	char ch2 = '\t';
	char ch3 = '\\';
	char ch4 = '\'';
	char ch5 = '"';

	// Increment/Decrement and compound assignment
	a++; a--; a += 2; a -= 3; a *= 4; a /= 2; a %= 5;
	a &= 1; a |= 2; a ^= 3; a <<= 1; a >>= 1;

	// Arithmetic and precedence
	int r = (a + x - 3) * 5 / 2 % 7;

	// Relational and logical
	bool cond = (x == 10) && (y >= 2.5) || (a < 100) && !(b || false) && true;

	// Bitwise and shifts
	int sh = (a << 2) >> 1; sh <<= 3; sh >>= 1; a = ~a;

	// If / elif / else and ternary
	if (cond) {
		print;
	} elif (x <= 5) {
		read;
	} else {
		a = b ? 1 : 2;
	}

	// While / continue
	while (a < 5) {
		a = a + 1;
		if (a == 3) continue;
	}

	// Do-while
	do {
		a = a - 1;
	} while (a > 0);

	// Switch / case / default / break
	switch (a) {
		case 0: a = 1; break;
		case 1: a = 2; break;
		default: a = 0;
	}

	// Arrays and indexing, dot access
	int arr[3];
	arr[0] = 1;
	arr[1] = 2;
	arr[2] = 3;
	s.length; // dot token test

	/* Block comment with * and / characters inside
	   Still in comment */

	// Booleans and null literal (both keyword and string literal)
	bool fl = false; bool tr = true; string nulllit = "null"; null;

	return x;
}
